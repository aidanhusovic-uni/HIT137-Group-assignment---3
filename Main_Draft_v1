from tkinter import *
from tkinter import filedialog 
# Import Pillow to handle JPEG/PNG images
from PIL import Image, ImageTk 

root = Tk()

root.geometry('1440x1080') #screen size

root.configure( bg= 'gray') #sets the screens backround colour


image_label = Label(root) # Create a Label widget to act as a placeholder for the image
image_label.place(x=500, y=200) # Centered horizontally relative to a 500px wide image

def open_images():
    file_path = filedialog.askopenfilename(
        initialdir="C:Pictures/",
        title="Select an Image",
        filetypes=[("Image Files", "*.png *.jpg *.jpeg *")]
    )
    
    if file_path:
        #Open the image file
        img = Image.open(file_path)
        
        #Resize the image 
        img.thumbnail((1080, 1080))
        
        # 3. Convert the Image object into a Tkinter-compatible photo image
        tk_img = ImageTk.PhotoImage(img)
        
        #Update the label to display the image
        image_label.config(image=tk_img)

        #Gives the image its position
        image_label .place(x = 390, y = 200)
        
        #Crucial to keep a reference to the image so Python's garbage collector doesnt erase it
        image_label.image = tk_img

topFrame = Frame(root)
topFrame.pack()

bottomFrame = Frame(root)
bottomFrame.pack(side=BOTTOM)

btn_normal = Button(root, text='Choose file', width=15, height=2, command=open_images, bg='black', fg='white', activebackground='blue', activeforeground='yellow')
btn_normal.pack(pady=10)
btn_normal.place(x=705, y=10)

root.mainloop()
