class ImagePuzzle:

    # Maximum displayed image size.
    MAX_SCREEN_WIDTH = 800
    MAX_SCREEN_HEIGHT = 800

    def __init__(self, grid_size=3):

        #Set the initial puzzle values.
        self.grid_size = grid_size #Set the grid size for the puzzle
        self.original_image = None #Store the original image for the puzzle
        self.tiles = [] #Store the tiles for the puzzle
        self.transformations = [] #Store the transformations applied to the tiles
        self.moves = 0 # Store the number of moves made in the puzzle
        self.hints_used = 0 # Store the number of hints used in the puzzle
        self.solved = False # Store whether the puzzle is solved or not

    #load image function

    def load_image(self, file_path): #Load an image from the specified path and prepare it for the puzzle.

        #Read the image from disk.
        image = cv2.imread(file_path) #read the image using OpenCV

        if image is None: #if the image could not be read, raise an error
            raise ValueError('OpenCV could not read the selected image.')

        # Prepare the image and create the puzzle.
        image = self.__resize_to_screen(image) #Resize the image to fit the screen
        image = self.__make_square_and_divisible(image) #Make the image square and divisible by the grid size
        self.original_image = image.copy() #Store a copy of the original image

        self.__create_tiles() #Create the tiles for the puzzle
        self.__scramble_tiles() #Scramble the tiles to create the puzzle

        #Reset the game state.
        self.moves = 0 #Reset the number of moves made in the puzzle
        self.hints_used = 0# Reset the number of hints used in the puzzle
        self.solved = False #Reset the solved state of the puzzle

    def __resize_to_screen(self, image):

        #Resize the image to fit within a certain size while maintaining the aspect ratio.
        height, width = image.shape[:2] #Get the height and width of the image

        #Vars for calculating the scale factor to fit the image within the maximum screen size
        scale = min(self.MAX_SCREEN_WIDTH / width, self.MAX_SCREEN_HEIGHT / height, 1.0) #Calculate the scale factor to fit the image within the maximum screen size
        new_width = int(width * scale) #Calculate the new width of the image based on the scale factor
        new_height = int(height * scale) #Calculate the new height of the image based on the scale factor
        return cv2.resize(image, (new_width, new_height)) #Resize the image using OpenCV and return the resized image

    def __make_square_and_divisible(self, image):

        #Make the image square and divisible by the grid size.
        height, width = image.shape[:2] #Get the height and width of the image

        #Crops our image 
        side = min(height, width) #Calculate the side length of the square image based on the minimum of the height and width
        side = (side // self.grid_size) * self.grid_size #Adjust the side length to be divisible by the grid size

        if side < self.grid_size: #if the side length is less than the grid size, raise an error
            raise ValueError('Image is too small for the specified grid size.')

        start_x = (width - side) // 2 #Calculate the starting x-coordinate for cropping the image
        start_y = (height - side) // 2 #Calculate the starting y-coordinate for cropping the image
        return image[start_y:start_y + side, start_x:start_x + side].copy() #Crop the image to a square and return the cropped image

    def __create_tiles(self):

        #Clears existing tiles
        self.tiles = [] #Clear the existing tiles list

        #Calculate the size of each tile based on the grid size.
        tile_height = self.original_image.shape[0] // self.grid_size #Calculate the height of each tile based on the grid size
        tile_width = self.original_image.shape[1] // self.grid_size #Calculate the width of each tile based on the grid size
        tile_id = 0 #Initialize the tile ID counter

        #Create the tiles by slicing the original image into smaller pieces.

        for row in range(self.grid_size): #Loop through each row of the grid
            for col in range(self.grid_size): #Loop through each column of the grid
                y1 = row * tile_height #Calculate the starting y-coordinate for the tile
                y2 = y1 + tile_height #Calculate the ending y-coordinate for the tile
                x1 = col * tile_width #Calculate the starting x-coordinate for the tile
                x2 = x1 + tile_width #Calculate the ending x-coordinate for the tile
                tile_image = self.original_image[y1:y2, x1:x2].copy() #Slice the original image to create the tile image
                self.tiles.append(Tile(tile_id, tile_image)) #Create a new tile object and add it to the tiles list
                tile_id += 1 #Increment the tile ID counter

    def __scramble_tiles(self):

        self.transformations = [] #Clear the existing transformations list

        transfer_counts = {3: 6, 4: 12, 5:20} #Define the number of transformations to apply based on the grid size 
        count = transfer_counts.get(self.grid_size, 6) #Get the number of transformations to apply based on the grid size, defaulting to 6 if not specified

        #Apply all of our random trnsformations to the tiles to scramble them.
        for i in range(count): #Loop through the number of transformations to apply

            tile_choice = random.choice(self.tiles) #Randomly select a tile from the tiles list

            if i =='swap': #If the transformation is a swap, randomly select two different tiles to swap
                #selection and swap for 2 random tiles
                pos_a, pos_b = random.sample(range(len(self.tiles)), 2) #Randomly select two different tile positions to swap
                transfer = SwapTransfer(pos_a, pos_b) #Create a new SwapTransfer object with the selected tile positions
                transfer.apply(self.tiles) #Apply the swap transformation to the tiles list

            elif i == 'rotate': #Else if the transformation is a rotation, randomly select a tile and a rotation angle to apply
                #Select a random tile and a random rotate angle
                index = random.randrange(len(self.tiles)) #Randomly select a tile index from the tiles list
                angle = random.choice([90, 180, 270]) #Randomly select a rotation angle from the specified options
                transfer = RotateTransfer(angle) #Create a new RotateTransfer object with the selected rotation angle

                #apply our rotation
                for _ in range(angle // 90): #Loop through the number of 90-degree rotations to apply based on the selected angle
                    self.tiles[index].rotate_cw() #Rotate the selected tile clockwise by 90 degrees

            else: #Else if the transformation is a flip, randomly select a tile and a flip direction to apply
                #Random tile selection to flip:

                index = random.randrange(len(self.tiles)) #Randomly select a tile index from the tiles list
                flip_direction = random.choice(['horizontal', 'vertical']) #Randomly select a flip direction from the specified options
                transfer = FlipTransfer(flip_direction) #Create a new FlipTransfer object with the selected flip direction
                self.tiles[index].flip(flip_direction) #Flip the selected tile in the specified direction

                #Apply the transformation to the list of transformations for undo functionality.
                if direction == 'horizontal': #if the flip is horizontal
                    self.tiles [index].flip_horizontal() #Flip the selected tile horizontally
                else: #if the flip is vertical
                    self.tiles [index].flip_vertical() #Flip the selected tile vertically

            #Store our transformation for undo functionality.
            self.transformations.append(transfer) #Add the transformation to the transformations list for undo functionality

    def get_tile_size (self):
        #Return the size of each tile as a tuple (width, height).
        height, width = self.original_image.shape[:2] #Get the height and width of the original image
        return (width // self.grid_size, height // self.grid_size) #Return the size of each tile as a tuple (width, height) based on the grid size

    def assemble_image (self):

        #Create rows 

        rows = []

        for row in range (self.grid_size): #Loop through each row of the grid
            row_tiles = [self.tiles[row * self.grid_size + col].current_image for col in range(self.grid_size)] #Get the current images of the tiles in the current row
            rows.append(np.hstack(row_tiles)) #Horizontally stack the tiles in the current row and add it to the rows list

        return np.vstack(rows) #Vertically stack the rows to create the assembled image and return it

    def swap_tiles (self, pos_a, pos_b):

        #Swap our 2 selected tiles and count a move
        self.tiles[pos_a], self.tiles[pos_b] = self.tiles[pos_b], self.tiles[pos_a] #Swap the tiles at the specified positions
        self.moves += 1 #Increment the move counter

    def rotate_tile (self, index):

        #Rotate our selected tile and count a move
        self.tiles[index].rotate_cw() #Rotate the tile at the specified index clockwise by 90 degrees
        self.moves += 1 #Increment the move counter

    def flip_tile (self, index, direction = 'horizontal'):

        #Flip our selected tile and count a move
        if direction == 'horizontal': #If the flip direction is horizontal
            self.tiles[index].flip_horizontal() #Flip the tile at the specified index horizontally
        else: #If the flip direction is vertical
            self.tiles[index].flip_vertical() #Flip the tile at the specified index vertically
        self.moves += 1 #Increment the move counter

    def tile_correct (self, index):

        #Check if the tile at the specified index is in its correct orientation.
        tile = self.tiles[index] #Get the tile at the specified index
        return self.tiles[index].is_correct_orientation() #Return True if the tile is in its correct orientation, False otherwise

    def tile_incorrect (self):

        #Check the incorrect tiles

        #Counter for checking incorrect tiles 
        return sum (not self.tile_correct (index) for index in range (len(self.tiles)))

    def check_solve (self):

        #Checks if any tiles not correct
        self.solved = self.tile_incorrect() == 0
        return self.check_solve

    def hint (self):

        #Find a incorrect tile then its correct pos
        #Loop through the tiles to find the first one 
        for current_index in range (len(self.tiles)):
            if not self.tile_correct(current_index):
                return current_index, self.tiles [current_index].tile_id
        return None

    def solve (self):

        #Returns all tiles to home pos
        tile_order = [None] * len(self.tiles)

        
        for tile in self.tiles:
            tile_order [tile.tile_id] = tile

        self.tiles = tile_order

        #Restores the original pos
        for tile in self.tiles:
            tile.reset()

        #reset the counter
        self.moves = 0
        self.hints_used = 0
        self.sovled = True

