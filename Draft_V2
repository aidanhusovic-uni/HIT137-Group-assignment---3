        # Add the Solve button.
        tk.Button(control_frame, text='Solve', command=self.solve_puzzle, bg='#ff003c', fg='white', font=('Arial', 11, 'bold'), relief=tk.FLAT, padx=12, pady=4).pack(side=tk.LEFT, padx=(10, 0))


    def tile_controls(self):


        # Create the tile control panel.
        frame = tk.LabelFrame(self.root, text='Tile Controls', bg='#1e1e2e', fg='white', font=('Arial', 10, 'bold'), padx=10, pady=8)
        frame.pack(fill=tk.X, padx=12, pady=(0, 8))


        # Add the selected tile dropdown.
        tk.Label(frame, text='Selected tile:', bg='#1e1e2e', fg='white', font=('Arial', 10)).grid(row=0, column=0, padx=(0, 5))


