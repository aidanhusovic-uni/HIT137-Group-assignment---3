#Transfer function class
class Transfer: #Provides a shared description and apply and undo structure for transfers

    def __init__ (self, description) :

        #Saves the description inside the object using self
        self.description = description

    def apply (self, value):

        #Stops the base class from being used directly by raising an error
        raise NotImplementedError('Override this method in subclasses')

    def undo (self, value) :

        #Stops the base class from being used directly by raising an error
        raise NotImplementedError('Override this method in subclasses')

    def __str__ (self) :

        #Returns the stored description when the object is printed
        return self.description

#Swap transfer function class
class SwapTransfer (Transfer): #Swaps two tiles by exchanging their positions in the tile list

    def __init__ (self, pos_a, pos_b) :

        #Passes a swap description to the base class and saves both positions
        super ().__init__(f'Swap Tiles {pos_a} and {pos_b}')
        self.pos_a = pos_a
        self.pos_b = pos_b

    def apply (self, tiles):

        #Uses tuple unpacking to exchange the two list positions at the same time
        tiles[self.pos_a], tiles[self.pos_b] = tiles[self.pos_b], tiles[self.pos_a]

    def undo (self, value) :

        #Reverses the swap by applying the same exchange a second time
        self.apply(value)

#Rotate transfer class
class RotateTransfer (Transfer):
    #Rotates images by linking angles to OpenCV rotation flags
    ROTATIONS = {90: cv2.ROTATE_90_CLOCKWISE, 180: cv2.ROTATE_180, 270: cv2.ROTATE_90_COUNTERCLOCKWISE}

    def __init__ (self, angle) :

        #Checks the angle against the dictionary keys before saving it
        if angle not in self.ROTATIONS:
            raise ValueError('Angle must be one of 90, 180 or 270 degrees.')

        super().__init__(f'Rotate Image by {angle} degrees')
        self.angle = angle

    def apply (self, image):

        #Looks up the rotation flag and passes it to OpenCV with the image
        return cv2.rotate(image, self.ROTATIONS[self.angle])

    def undo (self, image):
        #Calculates the opposite angle using 360 minus the original angle
        return cv2.rotate(image, self.ROTATIONS [(360 - self.angle) %360])

    @classmethod #Allows the function to run directly from the class
    def apply_angle (cls, image, angle):

        #Returns an unchanged copy when the angle is 0, otherwise uses the matching rotation flag
        if angle == 0:
            return image.copy()

        return cv2.rotate(image, cls.ROTATIONS[angle])

#Flip transfer class
class FlipTransfer (Transfer): #Flips images by choosing the correct OpenCV flip code

    def __init__ (self, direction) :

        #Checks the direction against the allowed horizontal and vertical options
        if direction not in ['horizontal', 'vertical']:
            raise ValueError("Direction must be 'horizontal' or 'vertical'.")

        description = 'Flip tile Horizontally' if direction == 'horizontal' else 'Flip tile Vertically'
        super().__init__(description)
        self.direction = direction

    def apply (self, image):

        #Chooses flip code 1 for horizontal and 0 for vertical before calling OpenCV
        flip_n = 1 if self.direction == 'horizontal' else 0
        return cv2.flip(image, flip_n)

    def undo (self, image):

        #Reverses the flip by applying the same flip a second time
        return self.apply(image)

#Tile class
class Tile:

    def __init__(self, tile_id, image):
        #Stores the tile ID and keeps separate copies of the original and current images
        self.__tile_id = tile_id
        self.__original_image = image.copy()
        self.__current_image = image.copy()

        #Starts the rotation and flip tracking values at zero
        self.__rotation = 0
        self.__flipped_horizontal = False
        self.__flipped_vertical = False

    @property #Makes the tile ID readable without allowing direct assignment
    def tile_id(self):
        #Returns the private tile ID through a controlled property
        return self.__tile_id

    @property
    def current_image(self):
        #Returns the private current image through a controlled property
        return self.__current_image

    @current_image.setter #Allows the current image to be replaced safely
    def current_image(self, image):
        #Saves the new image into the private current-image variable
        self.__current_image = image

    @property
    def rotation (self):
        #Returns the private rotation value through a controlled property
        return self.__rotation

    @property
    def flipped_horizontal (self):
        #Returns the private horizontal flip value through a controlled property
        return self.__flipped_horizontal

    @property
    def flipped_vertical (self):
        #Returns the private vertical flip value through a controlled property
        return self.__flipped_vertical

    def rotate_cw (self):
        #Rotates the image by 90 degrees and adds 90 to the rotation value using modulo 360
        self.__current_image = RotateTransfer.apply_angle(self.__current_image, 90)
        self.__rotation = (self.__rotation + 90) % 360

    def flip_horizontal (self):
        #Applies a horizontal flip and reverses the horizontal flip value using not
        self.__current_image = FlipTransfer('horizontal').apply(self.__current_image)
        self.__flipped_horizontal = not self.__flipped_horizontal

    def flip_vertical (self):
        #Applies a vertical flip and reverses the vertical flip value using not
        self.__current_image = FlipTransfer('vertical').apply(self.__current_image)
        self.__flipped_vertical = not self.__flipped_vertical

    def is_correct_orientation (self):
        #Compares every pixel in the current and original images using NumPy
        return np.array_equal(self.__current_image, self.__original_image)

    def reset_orientation (self):
        #Copies the original image back and resets the rotation and flip values to zero
        self.__current_image = self.__original_image.copy()
        self.__rotation = 0
        self.__flipped_horizontal = False
        self.__flipped_vertical = False

#Main puzzle function class
class ImagePuzzle:
    #Stores the maximum width and height used when displaying images
    MAX_SCREEN_WIDTH = 800
    MAX_SCREEN_HEIGHT = 800

    def __init__(self, grid_size=3):

        #Creates the puzzle values and starts the game with no image or tiles
        self.grid_size = grid_size
        self.original_image = None
        self.tiles = []
        self.transformations = []
        self.moves = 0
        self.hints_used = 0
        self.solved = False

    #Load image function
    def load_image(self, file_path): #Loads an image by resizing, cropping, tiling and scrambling it

        #Reads the chosen file into an OpenCV image array
        image = cv2.imread(file_path)

        if image is None: #Checks whether OpenCV returned a valid image
            raise ValueError('OpenCV could not read the selected image.')

        #Passes the image through the resize and crop functions before storing it
        image = self.__resize_to_screen(image)
        image = self.__make_square_and_divisible(image)
        self.original_image = image.copy()

        self.__create_tiles()
        self.__scramble_tiles()

        #Resets the move, hint and solved values for a new game
        self.moves = 0
        self.hints_used = 0
        self.solved = False

    def __resize_to_screen(self, image):

        #Calculates a scale factor and resizes the image using OpenCV
        height, width = image.shape[:2]
        scale = min(self.MAX_SCREEN_WIDTH / width, self.MAX_SCREEN_HEIGHT / height, 1.0)
        new_width = int(width * scale)
        new_height = int(height * scale)
        return cv2.resize(image, (new_width, new_height))

    def __make_square_and_divisible(self, image):

        #Finds the largest square side length that divides evenly by the grid size
        height, width = image.shape[:2]
        side = min(height, width)
        side = (side // self.grid_size) * self.grid_size

        if side < self.grid_size: #Checks whether the cropped image is large enough
            raise ValueError('Image is too small for the specified grid size.')

        #Calculates the centred starting position using integer division
        start_x = (width - side) // 2
        start_y = (height - side) // 2
        return image[start_y:start_y + side, start_x:start_x + side].copy()

    def __create_tiles(self):

        #Clears the tile list before creating a new set of tiles
        self.tiles = []

        #Divides the image size by the grid size to calculate each tile size
        tile_height = self.original_image.shape[0] // self.grid_size
        tile_width = self.original_image.shape[1] // self.grid_size
        tile_id = 0

        #Cuts the image using row and column positions calculated from the tile size
        for row in range(self.grid_size):
            for col in range(self.grid_size):
                y1 = row * tile_height
                y2 = y1 + tile_height
                x1 = col * tile_width
                x2 = x1 + tile_width
                tile_image = self.original_image[y1:y2, x1:x2].copy()
                self.tiles.append(Tile(tile_id, tile_image))
                tile_id += 1

    def __scramble_tiles(self):

        #Clears the transformation list before applying new random changes
        self.transformations = []

        transfer_counts = {3: 6, 4: 12, 5:20} #Looks up the transformation count using the grid size
        count = transfer_counts.get(self.grid_size, 6)

        #Repeatedly chooses one of the three transformation types and applies it
        for i in range(count):
            choice = random.choice(['swap', 'rotate', 'flip'])

            if choice =='swap': #Selects two different positions and exchanges their tiles
                pos_a, pos_b = random.sample(range(len(self.tiles)), 2)
                transfer = SwapTransfer(pos_a, pos_b)
                transfer.apply(self.tiles)

            elif choice == 'rotate': #Selects a tile and applies a random multiple of 90 degrees
                index = random.randrange(len(self.tiles))
                angle = random.choice([90, 180, 270])
                transfer = RotateTransfer(angle)

                for _ in range(angle // 90): #Applies one 90-degree rotation at a time
                    self.tiles[index].rotate_cw()

            else: #Selects a tile and applies either a horizontal or vertical flip
                index = random.randrange(len(self.tiles))
                direction = random.choice(['horizontal', 'vertical'])
                transfer = FlipTransfer(direction)

                if direction == 'horizontal': #Calls the Tile method matching the chosen direction
                    self.tiles [index].flip_horizontal()
                else:
                    self.tiles [index].flip_vertical()

            #Appends the transformation object to the undo list
            self.transformations.append(transfer)

    def get_tile_size (self):

        #Divides the image width and height by the grid size
        height, width = self.original_image.shape[:2]
        return (width // self.grid_size, height // self.grid_size)

    def assemble_image (self):

        #Joins tile images into rows using hstack and stacks the rows using vstack
        rows = []

        for row in range (self.grid_size):
            row_tiles = [self.tiles[row * self.grid_size + col].current_image for col in range(self.grid_size)]
            rows.append(np.hstack(row_tiles))

        return np.vstack(rows)

    def swap_tiles (self, pos_a, pos_b):

        #Exchanges two list positions using tuple unpacking and increases the move count
        self.tiles[pos_a], self.tiles[pos_b] = self.tiles[pos_b], self.tiles[pos_a]
        self.moves += 1

    def rotate_tile (self, index):

        #Calls the tile rotation method and increases the move count
        self.tiles[index].rotate_cw()
        self.moves += 1

    def flip_tile (self, index, direction = 'horizontal'):

        #Chooses the horizontal or vertical Tile method and increases the move count
        if direction == 'horizontal':
            self.tiles[index].flip_horizontal()
        else:
            self.tiles[index].flip_vertical()
        self.moves += 1

    def tile_correct (self, index):

        #Compares the tile ID with its list position and checks its image
        tile = self.tiles [index]
        return tile.tile_id == index and tile.is_correct_orientation()

    def tile_incorrect (self):

        #Counts every tile that fails the correct-position and image check
        return sum (not self.tile_correct (index) for index in range (len(self.tiles)))

    def check_solved (self):

        #Sets solved to True when the incorrect tile count reaches zero
        self.solved = self.tile_incorrect() == 0
        return self.solved

    def hint (self):

        #Finds the first tile that fails the correct check and returns both positions
        for current_index in range (len(self.tiles)):
            if not self.tile_correct(current_index):
                return current_index, self.tiles [current_index].tile_id
        return None

    def solve (self):

        #Places each tile into the list position matching its tile ID
        tile_order = [None] * len(self.tiles)

        for tile in self.tiles:
            tile_order [tile.tile_id] = tile

        self.tiles = tile_order

        #Calls reset_orientation on every tile to restore its original image
        for tile in self.tiles:
            tile.reset_orientation()

        #Clears the counters and marks the puzzle as solved
        self.moves = 0
        self.hints_used = 0
        self.solved = True

#Creating the Key UI features
class PuzzleCreate:
    #Create main window function
    def __init__ (self, root):

        #Sets the window title and background colour using the root window
        self.root = root
        self.root.title ('Scramble Puzzle / AIDAN HUSOVIC')
        self.root.configure (bg = '#1e1e1e')

        #Creates the puzzle object and sets the UI values to their starting state
        self.puzzle = ImagePuzzle()
        self.selected_tile = None
        self.hint_tile = None
        self.hint_home = None
        self.original_photo = None
        self.puzzle_photo = None

        #Builds the interface by calling each UI creation function
        self.controls()
        self.tile_controls()
        self.build_canvas()
        self.build_status_bar()

    def build_status_bar(self):

        #Creates a text variable and links it to a label packed at the bottom
        self.status_var = tk.StringVar(value='Load an image to begin')
        tk.Label(self.root, textvariable=self.status_var, bg='#121212', fg='#eaeaea', font=('Arial', 10), anchor='w', padx=12, pady=6).pack(fill=tk.X, side=tk.BOTTOM)

    def controls(self):

        #Packs a frame across the top and adds the grid selector and main buttons
        control_frame = tk.Frame(self.root, bg='#1e1e1e')
        control_frame.pack(fill=tk.X, padx=12, pady=10)

        #Adds a label and links a dropdown to the grid-size variable
        tk.Label(control_frame, text='Grid size:', bg='#1e1e1e', fg='#eaeaea', font=('Arial', 11)).pack(side=tk.LEFT)

        self.grid_size_var = tk.StringVar(value='3 x 3')
        ttk.Combobox(control_frame, textvariable=self.grid_size_var, values=['3 x 3', '4 x 4', '5 x 5'], state='readonly', width=8).pack(side=tk.LEFT, padx=(6, 15))

        #Creates buttons and connects each one to its command method
        tk.Button(control_frame, text='Load Image', command=self.load_image, bg='#2a41a8', fg='#ffffff', font=('Arial', 11, 'bold'), relief=tk.FLAT, padx=12, pady=4).pack(side=tk.LEFT)

        self.hint_button = tk.Button(control_frame, text='Hint', command=self.use_hint, bg='#2a41a8', fg='#ffffff', font=('Arial', 11, 'bold'), relief=tk.FLAT, padx=12, pady=4)
        self.hint_button.pack(side=tk.LEFT, padx=(15, 0))

        tk.Button(control_frame, text='Solve', command=self.solve_puzzle, bg='#2a41a8', fg='#ffffff', font=('Arial', 11, 'bold'), relief=tk.FLAT, padx=12, pady=4).pack(side=tk.LEFT, padx=(10, 0))

    def tile_controls(self):

        #Packs a labelled frame and adds the tile dropdowns and action buttons
        frame = tk.LabelFrame(self.root, text='Tile Controls', bg='#1e1e1e', fg='#eaeaea', font=('Arial', 10, 'bold'), padx=10, pady=8)
        frame.pack(fill=tk.X, padx=12, pady=(0, 8))

        #Adds a label and dropdown linked to the selected-tile variable
        tk.Label(frame, text='Selected tile:', bg='#1e1e1e', fg='#eaeaea', font=('Arial', 10)).grid(row=0, column=0, padx=(0, 5))

        self.selected_tile_var = tk.StringVar(value='')
        self.selected_tile_selector = ttk.Combobox(frame, textvariable=self.selected_tile_var, state='readonly', width=4)
        self.selected_tile_selector.grid(row=0, column=1, padx=(0, 15))
        self.selected_tile_selector.bind('<<ComboboxSelected>>', self.on_tile_selector_changed)

        #Adds a label and dropdown linked to the swap-target variable
        tk.Label(frame, text='Swap with tile:', bg='#1e1e1e', fg='#eaeaea', font=('Arial', 10)).grid(row=0, column=2, padx=(0, 5))

        self.swap_target_var = tk.StringVar(value='')
        self.swap_target_selector = ttk.Combobox(frame, textvariable=self.swap_target_var, state='readonly', width=4)
        self.swap_target_selector.grid(row=0, column=3, padx=(0, 15))

        #Creates buttons and connects them to the tile action methods
        tk.Button(frame, text='Rotate Clockwise', command=self.rotate_selected_tile, bg="#2a41a8", fg='#ffffff', font=('Arial', 10, 'bold'), relief=tk.FLAT, padx=10, pady=4).grid(row=0, column=4, padx=4)
        tk.Button(frame, text='Flip Horizontally', command=self.flip_selected_tile, bg='#2a41a8', fg='#ffffff', font=('Arial', 10, 'bold'), relief=tk.FLAT, padx=10, pady=4).grid(row=0, column=5, padx=4)
        tk.Button(frame, text='Deselect', command=self.deselect_tile, bg='#2a41a8', fg='#ffffff', font=('Arial', 10, 'bold'), relief=tk.FLAT, padx=10, pady=4).grid(row=0, column=7, padx=4)

    def build_canvas(self):

        #Packs a frame and creates two canvases for the reference and puzzle images
        frame = tk.Frame(self.root, bg='#1e1e1e')
        frame.pack(fill=tk.BOTH, expand=True, padx=12, pady=(0, 8))

        #Creates the original canvas and places it in the left grid column
        self.original_canvas = tk.Canvas(frame, width=ImagePuzzle.MAX_SCREEN_WIDTH, height=ImagePuzzle.MAX_SCREEN_HEIGHT, bg='#0f0f0f', highlightthickness=1, highlightbackground='#4a4a4a')
        self.original_canvas.grid(row=0, column=0, padx=(0, 12))

        #Creates the puzzle canvas and places it in the right grid column
        self.puzzle_canvas = tk.Canvas(frame, width=ImagePuzzle.MAX_SCREEN_WIDTH, height=ImagePuzzle.MAX_SCREEN_HEIGHT, bg='#0f0f0f', highlightthickness=1, highlightbackground='#4a4a4a')
        self.puzzle_canvas.grid(row=0, column=1)

        #Connects mouse events to their handler methods
        self.puzzle_canvas.bind('<Button-1>', self.on_left_click)
        self.puzzle_canvas.bind('<Button-3>', self.on_right_click)
        self.puzzle_canvas.bind('<Shift-Button-1>', self.on_shift_left_click)

        #Adds a label underneath the canvases to explain them
        tk.Label(self.root, text='Original image (reference) Puzzle image        (click or use buttons to solve)', bg='#1e1e1e', fg='#a0a0a0', font=('Arial', 10)).pack()

    def load_image(self):
        #Opens a file dialog and returns the selected file path
        file_path = filedialog.askopenfilename(title='Choose an image', filetypes=[('Image files', '*.jpg *.jpeg *.png *.bmp'), ('All files', '*.*')])

        #Stops the function when no file path is returned
        if not file_path:
            return

        #Splits the dropdown value and converts the number before the x into an integer
        self.puzzle.grid_size = int(self.grid_size_var.get().split('x')[0].strip())

        try:
            #Passes the file path to the puzzle class to load and scramble it
            self.puzzle.load_image(file_path)
        except Exception as error:
            #Displays the error message in a Tkinter message box
            messagebox.showerror('Image Error', str(error))
            return

        #Clears the selection and hint values and re-enables the hint button
        self.selected_tile = None
        self.hint_tile = None
        self.hint_home = None
        self.hint_button.config(state=tk.NORMAL)

        #Creates one dropdown choice for every tile in the puzzle
        choices = [str(index) for index in range(len(self.puzzle.tiles))]
        self.selected_tile_selector['values'] = choices
        self.swap_target_selector['values'] = choices
        self.selected_tile_var.set('')
        self.swap_target_var.set('')

        #Calls the display and status functions to refresh the interface
        self.display_images()
        self.update_status()

    def on_tile_selector_changed(self, event=None):
        #Converts the dropdown text into an integer and saves it as the selection
        try:
            self.selected_tile = int(self.selected_tile_var.get())
        except ValueError:
            self.selected_tile = None

        #Redraws the images and updates the status bar
        self.display_images()
        self.update_status()

    def get_tile_from_click(self, event):
        #Stops when no image is loaded or the puzzle has been solved
        if self.puzzle.original_image is None or self.puzzle.solved:
            return None

        #Divides the mouse position by the tile size to find the row and column
        tile_width, tile_height = self.puzzle.get_tile_size()
        col = event.x // tile_width
        row = event.y // tile_height

        #Converts the row and column into one tile index using the grid size
        if 0 <= col < self.puzzle.grid_size and 0 <= row < self.puzzle.grid_size:
            return row * self.puzzle.grid_size + col

        return None

    def on_left_click(self, event):
        #Finds the clicked tile index and handles selecting or swapping it
        index = self.get_tile_from_click(event)
        if index is None:
            return

        #Clears any active hint before processing the click
        self.clear_hint()

        #Selects the tile when no tile is currently selected
        if self.selected_tile is None:
            self.select_tile(index)

        #Deselects the tile when the same tile is clicked again
        elif self.selected_tile == index:
            self.deselect_tile()

        #Swaps the selected tile with the second clicked tile
        else:
            self.puzzle.swap_tiles(self.selected_tile, index)
            self.deselect_tile()
            self.after_player_move()
            self.display_images()
            self.update_status()

    def on_right_click(self, event):
        #Finds the clicked tile index and rotates that tile
        index = self.get_tile_from_click(event)
        if index is None:
            return

        #Clears the hint, rotates the tile and refreshes the interface
        self.clear_hint()
        self.puzzle.rotate_tile(index)
        self.deselect_tile()
        self.after_player_move()
        self.display_images()
        self.update_status()

    def on_shift_left_click(self, event):
        #Finds the clicked tile index and flips that tile horizontally
        index = self.get_tile_from_click(event)
        if index is None:
            return

        #Clears the hint, flips the tile and refreshes the interface
        self.clear_hint()
        self.puzzle.flip_tile(index, direction='horizontal')
        self.deselect_tile()
        self.after_player_move()
        self.display_images()
        self.update_status()

    def select_tile(self, index):
        #Saves the tile index and updates the dropdown text
        self.selected_tile = index
        self.selected_tile_var.set(str(index))
        self.display_images()
        self.update_status()

    def deselect_tile(self):
        #Clears the selected tile and resets the dropdown text
        self.selected_tile = None
        self.selected_tile_var.set('')
        self.display_images()
        self.update_status()

    def rotate_selected_tile(self):
        #Checks that a loaded and unsolved puzzle exists before rotating
        if not self.__can_use_tile_controls():
            return

        try:
            #Converts the dropdown text into a tile index
            index = int(self.selected_tile_var.get())
        except ValueError:
            messagebox.showinfo('No Tile Selected', 'Please select a tile first')
            return

        #Clears the hint, rotates the tile and refreshes the interface
        self.clear_hint()
        self.puzzle.rotate_tile(index)
        self.deselect_tile()
        self.after_player_move()
        self.display_images()
        self.update_status()

    def flip_selected_tile(self):
        #Checks that a loaded and unsolved puzzle exists before flipping
        if not self.__can_use_tile_controls():
            return

        try:
            #Converts the dropdown text into a tile index
            index = int(self.selected_tile_var.get())
        except ValueError:
            messagebox.showinfo('No Tile Selected', 'Please select a tile first')
            return

        #Clears the hint, flips the tile and refreshes the interface
        self.clear_hint()
        self.puzzle.flip_tile(index, direction='horizontal')
        self.deselect_tile()
        self.after_player_move()
        self.display_images()
        self.update_status()

    def swap_selected_tiles(self):
        #Checks that a loaded and unsolved puzzle exists before swapping
        if not self.__can_use_tile_controls():
            return

        try:
            #Converts both dropdown values into tile indexes
            index_a = int(self.selected_tile_var.get())
            index_b = int(self.swap_target_var.get())
        except ValueError:
            messagebox.showinfo('No Tile Selected', 'Please select both tiles first')
            return

        #Stops the swap when both dropdowns contain the same tile index
        if index_a == index_b:
            messagebox.showinfo('Swap Tiles', 'Choose two different tiles to swap')
            return

        #Clears the hint, swaps the tiles and refreshes the interface
        self.clear_hint()
        self.puzzle.swap_tiles(index_a, index_b)
        self.deselect_tile()
        self.after_player_move()
        self.display_images()
        self.update_status()

    def __can_use_tile_controls(self):
        #Checks whether the puzzle has an image loaded
        if self.puzzle.original_image is None:
            messagebox.showinfo('No Image', 'Load an image first')
            return False

        #Checks whether the puzzle has already been solved
        if self.puzzle.solved:
            messagebox.showinfo('Puzzle Solved', 'The puzzle is already solved')
            return False

        return True

    def after_player_move(self):
        #Checks whether the latest move solved the puzzle
        if self.puzzle.check_solved():
            messagebox.showinfo('Puzzle Solved', f'Congratulations! You restored the image in {self.puzzle.moves} moves')
            self.hint_button.config(state=tk.DISABLED)

    def display_images(self):
        #Stops when there is no image available to display
        if self.puzzle.original_image is None:
            return

        #Converts the OpenCV image from BGR to RGB before creating a Tkinter image
        original_rgb = cv2.cvtColor(self.puzzle.original_image, cv2.COLOR_BGR2RGB)
        self.original_photo = ImageTk.PhotoImage(Image.fromarray(original_rgb))

        #Assembles the puzzle image and converts it from BGR to RGB for Tkinter
        puzzle_rgb = cv2.cvtColor(self.puzzle.assemble_image(), cv2.COLOR_BGR2RGB)
        self.puzzle_photo = ImageTk.PhotoImage(Image.fromarray(puzzle_rgb))

        #Deletes all previous drawings from both canvases
        self.original_canvas.delete('all')
        self.puzzle_canvas.delete('all')

        #Draws both images at the top-left corner of their canvases
        self.original_canvas.create_image(0, 0, anchor=tk.NW, image=self.original_photo)
        self.puzzle_canvas.create_image(0, 0, anchor=tk.NW, image=self.puzzle_photo)

        #Draws the grid lines and tile markers over the images
        self.draw_grid(self.original_canvas)
        self.draw_grid(self.puzzle_canvas)
        self.draw_tile_markers()

    def draw_grid(self, canvas):
        #Stops when there is no image to draw the grid over
        if self.puzzle.original_image is None:
            return

        #Calculates each grid-line position by multiplying the tile size
        height, width = self.puzzle.original_image.shape[:2]
        tile_width, tile_height = self.puzzle.get_tile_size()

        #Draws a vertical and horizontal line for every grid division
        for index in range(1, self.puzzle.grid_size):
            x = index * tile_width
            y = index * tile_height

            canvas.create_line(x, 0, x, height, fill='#ffffff', stipple='gray50')
            canvas.create_line(0, y, width, y, fill='#ffffff', stipple='gray50')

    def draw_tile_markers(self):
        #Stops when there is no image to draw the markers over
        if self.puzzle.original_image is None:
            return

        #Gets the tile size needed to position the markers
        tile_width, tile_height = self.puzzle.get_tile_size()

        #Draws a rectangle around the selected tile using its top-left position
        if self.selected_tile is not None:
            x1, y1 = self.__tile_top_left(self.selected_tile)
            self.puzzle_canvas.create_rectangle(x1 + 2, y1 + 2, x1 + tile_width - 2, y1 + tile_height - 2, outline='#ffffff', width=4)

        #Draws a tick on every tile that passes the correct check
        for index in range(len(self.puzzle.tiles)):
            if self.puzzle.tile_correct(index):
                x1, y1 = self.__tile_top_left(index)
                self.puzzle_canvas.create_text(x1 + tile_width - 18, y1 + 18, text='✔', fill="#1ca12d", font=('Arial', 16, 'bold'))

        #Draws hint circles on the current and home tile positions
        if self.hint_tile is not None:
            self.__draw_hint_circle(self.puzzle_canvas, self.hint_tile)

        if self.hint_home is not None:
            self.__draw_hint_circle(self.original_canvas, self.hint_home)

    def __tile_top_left(self, index):
        #Calculates the row and column using modulo and integer division
        tile_width, tile_height = self.puzzle.get_tile_size()
        col = index % self.puzzle.grid_size
        row = index // self.puzzle.grid_size
        return col * tile_width, row * tile_height

    def __draw_hint_circle(self, canvas, index):
        #Calculates the tile centre and a radius based on the smaller tile side
        tile_width, tile_height = self.puzzle.get_tile_size()
        x1, y1 = self.__tile_top_left(index)
        centre_x = x1 + tile_width // 2
        centre_y = y1 + tile_height // 2
        radius = min(tile_width, tile_height) // 4

        #Draws an oval using the calculated centre and radius
        canvas.create_oval(centre_x - radius, centre_y - radius, centre_x + radius, centre_y + radius, outline='#a0a0a0', width=5)

    def clear_hint(self):
        #Clears both hint values and redraws the images without the markers
        self.hint_tile = None
        self.hint_home = None
        self.display_images()

    def use_hint(self):
        #Stops when no image is loaded or the puzzle is already solved
        if self.puzzle.original_image is None or self.puzzle.solved:
            return

        #Stops after three hints have been used
        if self.puzzle.hints_used >= 3:
            self.hint_button.config(state=tk.DISABLED)
            return

        #Finds an incorrect tile and its correct home position
        hint = self.puzzle.hint()
        if hint is None:
            messagebox.showinfo('Hint', 'The puzzle is already solved')
            return

        #Saves both hint positions and increases the hint count
        self.hint_tile, self.hint_home = hint
        self.puzzle.hints_used += 1

        if self.puzzle.hints_used >= 3:
            self.hint_button.config(state=tk.DISABLED)

        self.display_images()
        self.update_status()

    def solve_puzzle(self):
        #Stops when no image has been loaded
        if self.puzzle.original_image is None:
            messagebox.showinfo('Solve', 'Load an image first')
            return

        #Solves the puzzle and clears the selection and hint markers
        self.puzzle.solve()
        self.deselect_tile()
        self.clear_hint()
        self.hint_button.config(state=tk.DISABLED)
        self.display_images()
        self.update_status()

    def update_status(self):
        #Stops when no image has been loaded
        if self.puzzle.original_image is None:
            return

        #Calculates the incorrect tile count and remaining hint count
        incorrect = self.puzzle.tile_incorrect()
        hints_left = max(0, 3 - self.puzzle.hints_used)

        #Builds a different message depending on whether the puzzle is solved
        if self.puzzle.solved:
            message = f'Solved! Moves: {self.puzzle.moves} | Incorrect tiles: 0 | Hints remaining: {hints_left}'
        else:
            selected = 'None' if self.selected_tile is None else str(self.selected_tile)
            message = f'Moves: {self.puzzle.moves} | Incorrect tiles: {incorrect} | Hints remaining: {hints_left} | Selected tile: {selected}'

        #Updates the status-bar text variable
        self.status_var.set(message)

#Starts the Tkinter application
def main():
    #Creates the Tkinter window and PuzzleCreate object
    root = tk.Tk()
    PuzzleCreate(root)

    #Keeps the window open and responding to events
    root.mainloop()

#Run the program only when this file is executed
if __name__ == '__main__':
    main()