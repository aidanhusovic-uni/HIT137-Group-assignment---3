#Transfer function Class
class Transfer: #our base class for the tile transfers


    def __init__ (self, description) :


        self.description = description #stores the description of the transfer


    def apply (self, value):


        raise NotImplementedError("Override this method in subclasses")


    def undo (self, value) :


        raise NotImplementedError("Override this method in subclasses")


    def __str__ (self) :


        return self.description #Return the description of the transfer


#Swap Transfer function Class
class SwapTransfer (Transfer): #our subclass for the tile swap transfer


    def __init__ (self, pos_a, pos_b) :


        super ().__init__(f'Swap Tiles {pos_a} and {pos_b}') #call the base class constructor with a description of the transfer
        self.pos_a = pos_a #store the first position
        self.pos_b = pos_b #store the second position


    def apply (self, tiles):


        #swap the tiles at the two different positions
        tiles[self.pos_a], tiles[self.pos_b] = tiles[self.pos_b], tiles[self.pos_a]


    def undo (self, value) :


        #swap the tiles back to their original positions
        self.apply(value)


#Rotate Transfer Class
class RotateTransfer (Transfer):
    #Uses OpenCV to rotate the image by a specified angle (90, 180, or 270 degrees)
    ROTATIONS = {90: cv2.ROTATE_90_CLOCKWISE, 180: cv2.ROTATE_180, 270: cv2.ROTATE_90_COUNTERCLOCKWISE}  


    def __init__ (self, angle) :



        if angle not in self.ROTATIONS: #if statement for if the angle is not one of the specified values
            raise ValueError("Angle must be one of 90, 180, or 270 degrees.")
        
        super().__init__(f'Rotate Image by {angle} degrees') #call the base class constructor with a description of the transfer
        self.angle = angle 


    def apply (self, image):
        
        return cv2.rotate(image, self.ROTATIONS[self.angle])


    def undo (self, image):
        #rotates our image back to original pos (the 360% angle is to ensure that we get the correct rotation value for the undo)
        return cv2.rotate(image, self.ROTATIONS [(360 - self.angle) %360])
    
    @classmethod #this makes it so our new method can be called without creating an instance of the class


    def apply_angle (cls, image, angle):


        if angle == 0: #this disallows the image rotating if its angle is correct (at 0 degrees is true)
            return image.copy() #rotation isnt needed
        return cv2.rotate(image, cls.ROTATIONS[angle]) 


#Flip Transfer Class
class FlipTransfer (Transfer): #our subclass for the tile flip transfer


    def __init__ (self, direction) :
       #setting up our if statement to check if the direction is valid so not allowing it to do a flip if the direction is not valid
        if direction not in ['horizontal', 'vertical']:
            raise ValueError("Direction must be 'horizontal' or 'vertical'.")


        description = 'Flip tile Horizontally' if direction == 'horizontal' else 'Flip tile Vertically'
        super().__init__(description) #calling the base class constructor with a description of the transfer
        self.direction = direction 


    def apply (self, image):
        
        #sets the flip_n variable to 1 if the direction is horizontal, otherwise sets it to 0 for vertical
        flip_n = 1 if self.direction == 'horizontal' else 0 
        return cv2.flip(image, flip_n)


    def undo (self, image):
        
        return self.apply(image)  # flipping again will undo the flip


#Tile Class
class Tile:


    def __init__(self, tile_id, image):
        #Stores the tile ID and the original image for the tile
        self.__tile_id = tile_id 
        
        self.__original_image = image.copy()
       
        self.__current_image = image.copy()


        #vars to track the current rotation and flip state of the tile
        self.__rotation = 0 
        self.__flipped_horizontal = False 
        self.__flipped_vertical = False 


    @property #property decorator to make the tile ID read-only
    
    def tile_id(self):
        return self.__tile_id #return the tile ID to home pos


    @property
    def current_image(self):
        return self.__current_image #return the current image of the tile


    @current_image.setter #setter decorator to allow setting the current image of the tile
    def current_image(self, image):
        self.__current_image = image #set the current image of the tile


    @property
    def rotation (self):
        return self.__rotation #return the current rotation of the tile


    @property
    def flipped_horizontal (self):
        return self.__flipped_horizontal #return the current horizontal flip state of the tile


    @property
    def flipped_vertical (self):
        return self.__flipped_vertical #return the current vertical flip state of the tile


    def rotate_cw (self):
        #Rotate the tile 90 degrees clockwise
        self.__current_image = RotateTransfer.apply_angle(self.__current_image, 90) #rotate the current image using OpenCV
        #updates the tile pos by +90d 
        self.__rotation = (self.__rotation + 90) % 360 #update the rotation state



    def flip_horizontal (self):
        #Flip the tile horizontally
        self.__current_image = FlipTransfer('horizontal').apply(self.__current_image) #flip the current image using the custom FlipTransfer class
        self.__flipped_horizontal = not self.__flipped_horizontal #update the horizontal flip state


    def flip_vertical (self):
        #Flip the tile vertically
        self.__current_image = FlipTransfer('vertical').apply(self.__current_image) #flip the current image using the custom FlipTransfer class
        self.__flipped_vertical = not self.__flipped_vertical #update the vertical flip state


    def is_correct_orientation (self):
        #Check if the tile is in its original orientation (not rotated or flipped)
        return np.array_equal(self.__current_image, self.__original_image) #return True if the tile is in its original orientation, False otherwise


    def reset_orientation (self):
        #Reset the tile to its original orientation (not rotated or flipped)
        self.__current_image = self.__original_image.copy() #reset the current image to the original image
        self.__rotation = 0 
        self.__flipped_horizontal = False 
        self.__flipped_vertical = False 


#Main Puzzle function Class    
class ImagePuzzle:


    # Maximum displayed image size.
    MAX_SCREEN_WIDTH = 800
    MAX_SCREEN_HEIGHT = 800


    def __init__(self, grid_size=3):


        #Set the initial puzzle values.
        self.grid_size = grid_size 
        self.original_image = None 
        self.tiles = [] 
        self.transformations = [] 
        self.moves = 0 
        self.hints_used = 0 
        self.solved = False 


    #load image function


    def load_image(self, file_path): #Load an image from the specified path and prepare it for the puzzle.


        #Read the image from disk.
        image = cv2.imread(file_path) #read the image using OpenCV


        if image is None: #if the image could not be read, raise an error
            raise ValueError('OpenCV could not read the selected image.')


        # Prepare the image and create the puzzle.
        image = self.__resize_to_screen(image) 
        image = self.__make_square_and_divisible(image) 
        self.original_image = image.copy() 


        self.__create_tiles() 
        self.__scramble_tiles() 


        #Reset the game state.
        self.moves = 0 
        self.hints_used = 0
        self.solved = False 


    def __resize_to_screen(self, image):


        #Resize the image to fit within a certain size while maintaining the aspect ratio.
        height, width = image.shape[:2] #Get the height and width of the image


        #Vars for calculating the scale factor to fit the image within the maximum screen size
        scale = min(self.MAX_SCREEN_WIDTH / width, self.MAX_SCREEN_HEIGHT / height, 1.0) 
        new_width = int(width * scale) 
        new_height = int(height * scale) 
        return cv2.resize(image, (new_width, new_height)) 


    def __make_square_and_divisible(self, image):


        #Make the image square and divisible by the grid size.
        height, width = image.shape[:2] #Get the height and width of the image


        #Crops our image 
        side = min(height, width) 
        side = (side // self.grid_size) * self.grid_size 


        if side < self.grid_size: #if the side length is less than the grid size, raise an error
            raise ValueError('Image is too small for the specified grid size.')


        start_x = (width - side) // 2 
        start_y = (height - side) // 2 
        return image[start_y:start_y + side, start_x:start_x + side].copy() 


    def __create_tiles(self):


        #Clears existing tiles
        self.tiles = [] #Clear the existing tiles list


        #Calculate the size of each tile based on the grid size.
        tile_height = self.original_image.shape[0] // self.grid_size 
        tile_width = self.original_image.shape[1] // self.grid_size 
        tile_id = 0 


        #Create the tiles by slicing the original image into smaller pieces.


        for row in range(self.grid_size): #Loop through each row of the grid
            for col in range(self.grid_size): #Loop through each column of the grid
                y1 = row * tile_height 
                y2 = y1 + tile_height 
                x1 = col * tile_width 
                x2 = x1 + tile_width 
                tile_image = self.original_image[y1:y2, x1:x2].copy() 
                self.tiles.append(Tile(tile_id, tile_image)) 
                tile_id += 1 


    def __scramble_tiles(self):


        self.transformations = [] #Clear the existing transformations list


        transfer_counts = {3: 6, 4: 12, 5:20} #Define the number of transformations to apply based on the grid size 
        count = transfer_counts.get(self.grid_size, 6) 


        #Apply all of our random trnsformations to the tiles to scramble them.
        for i in range(count): #Loop through the number of transformations to apply


            choice = random.choice(['swap', 'rotate', 'flip']) #Randomly select the transformation type


            if choice =='swap': #If the transformation is a swap, randomly select two different tiles to swap
                #selection and swap for 2 random tiles
                pos_a, pos_b = random.sample(range(len(self.tiles)), 2) 
                transfer = SwapTransfer(pos_a, pos_b) 
                transfer.apply(self.tiles) 


            elif choice == 'rotate': #Else if the transformation is a rotation, randomly select a tile and a rotation angle to apply
                #Select a random tile and a random rotate angle
                index = random.randrange(len(self.tiles)) 
                angle = random.choice([90, 180, 270]) 
                transfer = RotateTransfer(angle) 


                #apply our rotation
                for _ in range(angle // 90): #Loop through the number of 90-degree rotations to apply based on the selected angle
                    self.tiles[index].rotate_cw() 


            else: #Else if the transformation is a flip, randomly select a tile and a flip direction to apply
                #Random tile selection to flip:


                index = random.randrange(len(self.tiles)) 
                direction = random.choice(['horizontal', 'vertical']) 
                transfer = FlipTransfer(direction) 
                
                #Apply the transformation to the list of transformations for undo functionality.
                if direction == 'horizontal': #if the flip is horizontal
                    self.tiles [index].flip_horizontal() 
                else: 
                    self.tiles [index].flip_vertical() 


            #Store our transformation for undo functionality.
            self.transformations.append(transfer) 


    def get_tile_size (self):
        
        height, width = self.original_image.shape[:2] 
        return (width // self.grid_size, height // self.grid_size) 


    def assemble_image (self):


        #Create rows 


        rows = []


        for row in range (self.grid_size): 
            row_tiles = [self.tiles[row * self.grid_size + col].current_image for col in range(self.grid_size)] 
            rows.append(np.hstack(row_tiles)) 


        return np.vstack(rows) 


    def swap_tiles (self, pos_a, pos_b):


        #Swap our 2 selected tiles and count a move
        self.tiles[pos_a], self.tiles[pos_b] = self.tiles[pos_b], self.tiles[pos_a] 
        self.moves += 1 


    def rotate_tile (self, index):


        #Rotate our selected tile and count a move
        self.tiles[index].rotate_cw() 
        self.moves += 1 


    def flip_tile (self, index, direction = 'horizontal'):


        #Flip our selected tile and count a move
        if direction == 'horizontal': 
            self.tiles[index].flip_horizontal() 
        else: 
            self.tiles[index].flip_vertical() 
        self.moves += 1 


    def tile_correct (self, index):


        #Check if the tile at the specified index is in its correct orientation.
        tile = self.tiles [index]
        return tile.tile_id == index and tile.is_correct_orientation()


    def tile_incorrect (self):


        #Check the incorrect tiles


        #Counter for checking incorrect tiles 
        return sum (not self.tile_correct (index) for index in range (len(self.tiles)))


    def check_solved (self):


        #Checks if any tiles not correct
        self.solved = self.tile_incorrect() == 0
        return self.solved


    def hint (self):


        #Find a incorrect tile then its correct pos
        #Loop through the tiles to find the first one 
        for current_index in range (len(self.tiles)):
            if not self.tile_correct(current_index):
                return current_index, self.tiles [current_index].tile_id
        return None


    def solve (self):


        #Returns all tiles to home pos
        tile_order = [None] * len(self.tiles)


        
        for tile in self.tiles:
            tile_order [tile.tile_id] = tile


        self.tiles = tile_order


        #Restores the original pos
        for tile in self.tiles:
            tile.reset_orientation()


        #reset the counter
        self.moves = 0
        self.hints_used = 0
        self.solved = True


class PuzzleCreate:


    #Create main window function


    def __init__ (self, root):


        #Configure main window
        self.root = root
        self.root.title ('Scramble Puzzle / AIDAN HUSOVIC')
        self.root.configure (bg = '#1e1e2e')


