from tkinter import *

from tkinter import filedialog

root = Tk()

root.geometry('1080x720')  #assigns the height and width of the window

def open_select_image ():

    file_path = filedialog.askopenfilename(
        initialdir = 'C/',
        title = 'Please select image',
        filetypes = [('Image Files', '*.png *.jpg *.jpeg')]
    )
    
    if file_path :

        print (f'Selected image {file_path}')

topFrame = Frame(root)

topFrame.pack() # Frame is a rectangular area that can contain other widgets


bottomFrame = Frame(root)

bottomFrame.pack(side=BOTTOM)

btn_normal = Button(root, text = 'Choose file', width = 15, height = 2, command= open_select_image)
btn_normal.pack(pady = 10)
btn_normal.place( x=500, y = 50)




root.mainloop()